{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sush Air",
  "version": "0.1.0",
  "identifier": "dev.moonshadow.sush.air",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sush Air",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420,
        "backgroundColor": "#0b0d10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
